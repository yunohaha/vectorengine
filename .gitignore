# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/


/target/
debug/
**/*.rs.bk
# Cargo.lock для исполняемых файлов (обычно оставляем, но можно и игнорировать)
# Cargo.lock

# ---> Tauri специфичное
# Сгенерированные файлы схем для автодополнения (можно коммитить, но часто игнорят)
/src-tauri/gen/
/gen/schemas/

# ---> Node.js / TypeScript (фронтенд Tauri)
# Зависимости
node_modules/
# Логи
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Сборка
dist/
dist-ssr/
*.local
# Переменные окружения
.env
.env.local
.env.*.local
# TypeScript
*.tsbuildinfo

# ---> Visual Studio Code
.vscode/*
# Но можно сохранять настройки, если нужно
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
# История VS Code
.history/

# ---> Операционные системы
# macOS
.DS_Store
.AppleDouble
.LSOverride
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
